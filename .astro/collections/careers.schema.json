{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "legacyId": {
      "type": "number"
    },
    "order": {
      "default": 100,
      "type": "number"
    },
    "image": {
      "type": "string"
    },
    "excerpt": {
      "default": "",
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "image"
  ]
}