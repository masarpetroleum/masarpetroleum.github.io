---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';

const entry = (await getEntry('pages', 'company'))!;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt} image={entry.data.hero}>
	<PageHeading
		title={entry.data.title}
		image={entry.data.hero}
		crumbs={[{ label: 'About', href: '/about/' }, { label: 'Company background', href: '/company/' }]}
	/>
	<div class="container page">
		<div class="prose">
			<Content />
		</div>
		<RelatedTopics tags={entry.data.tags} />
	</div>
</BaseLayout>
