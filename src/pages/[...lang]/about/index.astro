---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeading from '../../../components/PageHeading.astro';
import Card from '../../../components/Card.astro';
import { siteData } from '../../../consts';
import { langPaths, useT, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const { title, cards } = siteData(lang).PAGES.about;
---

<BaseLayout title={title} description={useT(lang)('aboutDescription')}>
	<PageHeading title={title} crumbs={[{ label: title, href: '/about/' }]} />
	<div class="container page">
		<div class="grid grid-2">
			{cards.map((c) => <Card href={c.href} image={c.image} title={c.title} variant="centered" eager />)}
		</div>
	</div>
</BaseLayout>
