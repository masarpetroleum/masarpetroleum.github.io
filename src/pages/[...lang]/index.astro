---
import BaseLayout from '../layouts/BaseLayout.astro';
import Billboard from '../components/Billboard.astro';
import NewsList from '../components/NewsList.astro';
import ArticleCarousel from '../components/ArticleCarousel.astro';
import { CONTACT, HOME, SITE } from '../consts';
import { renderText } from '../lib/text';

const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: `${SITE.name} SAOC`,
	alternateName: SITE.name,
	url: Astro.site?.href,
	logo: new URL(SITE.ogImage, Astro.site).href,
	foundingDate: '2015',
	address: { '@type': 'PostalAddress', streetAddress: CONTACT.address.join(' '), addressCountry: 'OM' },
	telephone: CONTACT.phone,
	email: CONTACT.email,
	sameAs: [CONTACT.linkedin].filter(Boolean),
};
const { intro } = HOME;
---

<BaseLayout>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(organization)} />

	{HOME.slides.length > 0 && <Billboard />}

	<section class="section section-tint" aria-labelledby="recent-news">
		<div class="container">
			<div class="section-head">
				<h2 id="recent-news">{HOME.newsTitle}</h2>
				<a class="link-arrow" href="/news/">All news</a>
			</div>
			<NewsList />
		</div>
	</section>

	<section class="about-band" aria-labelledby="about-masar">
		{intro.background && <img class="about-band-bg" src={intro.background} alt="" width="1600" height="900" loading="lazy" decoding="async" />}
		<div class="container">
			<div class="about-intro" data-reveal>
				<h2 id="about-masar">{intro.title}</h2>
				<Fragment set:html={renderText(intro.text)} />
				{
					intro.buttonHref && intro.buttonLabel && (
						<a class="btn-light" href={intro.buttonHref}>
							{intro.buttonLabel.replace(/\s*(\.{2,}|…)\s*$/, '')}
						</a>
					)
				}
			</div>
			<div class="values">
				{
					HOME.values.map((v) => (
						<article class="value-card" data-reveal>
							<img src={v.image} alt="" width="500" height="333" loading="lazy" decoding="async" />
							<div class="value-body">
								<h3>{v.title}</h3>
								<p>{v.text}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="recent-articles">
		<div class="container">
			<div class="section-head">
				<h2 id="recent-articles">{HOME.articlesTitle}</h2>
				<a class="link-arrow" href="/articles/">All articles</a>
			</div>
			<ArticleCarousel />
		</div>
	</section>
</BaseLayout>
