---
import { render } from 'astro:content';
import EntryLayout from '../../../components/EntryLayout.astro';
import { langPaths, type Lang } from '../../../i18n';
import { getPage } from '../../../lib/content';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const entry = await getPage('operations', lang);
const { Content } = await render(entry.source);
---

<EntryLayout
	title={entry.data.title}
	description={entry.data.excerpt}
	image={entry.data.gallery[0]}
	crumbs={[{ label: entry.data.title, href: '/operations/' }]}
	gallery={entry.data.gallery}
	tags={entry.data.tags}
	tagKeys={entry.tagKeys}
	translated={entry.translated}
>
	<Content />
</EntryLayout>
