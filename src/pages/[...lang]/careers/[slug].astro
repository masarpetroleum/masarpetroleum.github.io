---
import { render } from 'astro:content';
import EntryLayout from '../../components/EntryLayout.astro';
import { getCareers } from '../../lib/content';

export async function getStaticPaths() {
	return (await getCareers()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
	title={entry.data.title}
	subtitle={entry.data.status}
	description={entry.data.excerpt}
	image={entry.data.image}
	crumbs={[{ label: 'Careers', href: '/careers/' }]}
>
	<Content />
</EntryLayout>
