---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeading from '../../../components/PageHeading.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Timeline from '../../../components/Timeline.astro';
import { siteData } from '../../../consts';
import { langPaths, type Lang } from '../../../i18n';
import { getPage } from '../../../lib/content';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const { about } = siteData(lang).PAGES;
const entry = await getPage('company', lang);
const { Content } = await render(entry.source);
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt} image={entry.data.hero}>
	<PageHeading
		title={entry.data.title}
		image={entry.data.hero}
		crumbs={[{ label: about.title, href: '/about/' }, { label: about.cards[0]?.title ?? entry.data.title, href: '/company/' }]}
	/>
	<div class="container page page-centered">
		<div class="prose">
			<Content />
		</div>
		{entry.data.timeline && <Timeline {...entry.data.timeline} />}
		<RelatedTopics tagKeys={entry.tagKeys} tags={entry.data.tags} />
	</div>
</BaseLayout>
