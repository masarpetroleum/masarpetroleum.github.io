---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeading from '../../../components/PageHeading.astro';
import Card from '../../../components/Card.astro';
import { siteData } from '../../../consts';
import { langPaths, localizePath, useT, type Lang } from '../../../i18n';
import { getEvents } from '../../../lib/content';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const { title } = siteData(lang).PAGES.events;
const entries = await getEvents(lang);
---

<BaseLayout title={title} description={useT(lang)('eventsDescription')}>
	<PageHeading title={title} crumbs={[{ label: title, href: '/events/' }]} />
	<div class="container page">
		<div class="grid grid-3">
			{entries.map((e, i) => <Card href={localizePath(`/events/${e.id}/`, lang)} image={e.data.image} title={e.data.title} subtitle={e.data.subtitle} eager={i < 4} />)}
		</div>
	</div>
</BaseLayout>
