---
import { render } from 'astro:content';
import { siteData } from '../../../consts';
import EntryLayout from '../../../components/EntryLayout.astro';
import { LOCALES, DEFAULT_LANG } from '../../../i18n';
import { getEvents } from '../../../lib/content';

export async function getStaticPaths() {
	const pages = await Promise.all(
		LOCALES.map(async (lang) =>
			(await getEvents(lang)).map((entry) => ({ params: { lang: lang === DEFAULT_LANG ? undefined : lang, slug: entry.id }, props: { entry, lang } })),
		),
	);
	return pages.flat();
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry.source);
---

<EntryLayout
	title={entry.data.title}
	subtitle={entry.data.subtitle}
	description={entry.data.excerpt}
	image={entry.data.image}
	crumbs={[{ label: siteData(lang).PAGES.events.title, href: '/events/' }]}
	gallery={entry.data.gallery}
	tags={entry.data.tags}
	tagKeys={entry.tagKeys}
	translated={entry.translated}
>
	<Content />
</EntryLayout>
