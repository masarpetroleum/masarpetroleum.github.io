---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeading from '../../../components/PageHeading.astro';
import NewsList from '../../../components/NewsList.astro';
import { siteData } from '../../../consts';
import { langPaths, useT, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const { title } = siteData(lang).PAGES.news;
---

<BaseLayout title={title} description={useT(lang)('newsDescription')}>
	<PageHeading title={title} crumbs={[{ label: title, href: '/news/' }]} />
	<div class="container page">
		<NewsList />
	</div>
</BaseLayout>
