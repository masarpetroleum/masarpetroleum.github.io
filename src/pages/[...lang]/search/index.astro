---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeading from '../../../components/PageHeading.astro';
import SearchForm from '../../../components/SearchForm.astro';
import { langPaths, localizePath, useT, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const t = useT(lang);
const texts = {
	prompt: t('searchPrompt'),
	searching: t('searching'),
	one: t('searchOne'),
	many: t('searchMany'),
	none: t('searchNone'),
	error: t('searchError'),
	labels: { articles: t('labelArticle'), events: t('labelEvent'), careers: t('labelCareers'), team: t('labelTeam'), pages: t('labelPage') },
};
---

<BaseLayout title={t('search')} description={t('searchDescription')}>
	<meta name="robots" content="noindex, follow" slot="head" />
	<PageHeading title={t('search')} crumbs={[{ label: t('search'), href: '/search/' }]} />
	<div class="container page search-page" data-index={localizePath('/search-index.json', lang)} data-texts={JSON.stringify(texts)}>
		<SearchForm id="page-search" />
		<p id="search-summary" role="status"></p>
		<ul class="search-results" id="search-results"></ul>
	</div>
</BaseLayout>

<script>
	interface Item {
		section: string;
		title: string;
		subtitle?: string;
		excerpt: string;
		image?: string;
		url: string;
		text: string;
	}

	const root = document.querySelector<HTMLElement>('.search-page')!;
	const texts = JSON.parse(root.dataset.texts!) as Record<'prompt' | 'searching' | 'one' | 'many' | 'none' | 'error', string> & { labels: Record<string, string> };
	const key = (new URLSearchParams(location.search).get('key') ?? '').trim();
	const input = document.getElementById('page-search') as HTMLInputElement;
	const summary = document.getElementById('search-summary')!;
	const list = document.getElementById('search-results')!;
	input.value = key;

	const escape = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
	// Arabic is matched without its vowel marks and with the common letter variants folded together.
	const fold = (s: string) =>
		s
			.toLowerCase()
			.replace(/[ً-ٰٟـ]/g, '')
			.replace(/[أإآ]/g, 'ا')
			.replace(/ى/g, 'ي')
			.replace(/ة/g, 'ه');
	const fill = (text: string, n: number) => text.replace('{n}', String(n)).replace('{key}', key);

	if (!key) {
		summary.textContent = texts.prompt;
		input.focus();
	} else {
		summary.textContent = texts.searching;
		fetch(root.dataset.index!)
			.then((r) => r.json())
			.then((items: Item[]) => {
				const terms = fold(key).split(/\s+/).filter(Boolean);
				const scored = items
					.map((item) => {
						const title = fold(item.title);
						const hay = `${title} ${fold(item.subtitle ?? '')} ${fold(item.text)}`;
						if (!terms.every((term) => hay.includes(term))) return null;
						const score = terms.reduce((s, term) => s + (title.includes(term) ? 10 : 0) + hay.split(term).length - 1, 0);
						return { item, score };
					})
					.filter((x): x is { item: Item; score: number } => !!x)
					.sort((a, b) => b.score - a.score);

				summary.textContent = fill(scored.length === 0 ? texts.none : scored.length === 1 ? texts.one : texts.many, scored.length);
				list.innerHTML = scored
					.map(
						({ item }) => `<li><a href="${escape(item.url)}">
							${item.image ? `<img src="${escape(item.image)}" alt="" width="96" height="96" loading="lazy">` : '<span></span>'}
							<span><span class="tag">${escape(texts.labels[item.section] ?? '')}</span>
							<strong>${escape(item.title)}</strong>
							<small>${escape(item.subtitle ? item.subtitle + ' — ' : '')}${escape(item.excerpt)}</small></span>
						</a></li>`,
					)
					.join('');
			})
			.catch(() => (summary.textContent = texts.error));
	}
</script>
