---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { CONTACT, MESSAGES_API, PAGES, TURNSTILE_SITE_KEY } from '../../consts';

// Directions go to the same point the embedded map is centred on.
const [, lng, lat] = CONTACT.mapEmbed.match(/!2d(-?[\d.]+)!3d(-?[\d.]+)/) ?? [];
const directions =
	lat && lng
		? `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`
		: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${CONTACT.company}, ${CONTACT.address.join(' ')}`)}`;
---

<BaseLayout title={PAGES.contact.title} description={`Contact ${CONTACT.company} — ${CONTACT.address.join(' ')} Phone ${CONTACT.phone}.`}>
	<PageHeading title={PAGES.contact.title} crumbs={[{ label: 'Contact', href: '/contact/' }]} />
	<div class="container page">
		<div class="contact-grid">
			<div class="contact-info">
				<ul class="contact-list">
					<li>
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle>
						</svg>
						<span><strong>{CONTACT.company}</strong>{CONTACT.address.map((line) => (<><br />{line}</>))}</span>
					</li>
					<li>
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"></path>
						</svg>
						<span>Phone: <a href={CONTACT.phoneHref}>{CONTACT.phone}</a></span>
					</li>
					<li>
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 6-10 7L2 6"></path>
						</svg>
						<span>Email: <a href="#" data-email={CONTACT.email.split('').reverse().join('')}>{CONTACT.email.replace('@', ' [at] ')}</a></span>
					</li>
				</ul>

				<h2 class="contact-form-title">Send us a message</h2>
				<form class="form" id="contact-form" data-endpoint={MESSAGES_API} novalidate>
					<!-- People never see this field; bots fill it in and are ignored. -->
					<div class="form-trap" aria-hidden="true">
						<label for="cf-hp">Leave this field empty</label>
						<input id="cf-hp" name="hp_leave_empty" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" />
					</div>
					<div class="field">
						<label for="cf-name">Name</label>
						<input id="cf-name" name="name" required autocomplete="name" />
					</div>
					<div class="field-row">
						<div class="field">
							<label for="cf-phone">Phone</label>
							<input id="cf-phone" name="phone" type="tel" autocomplete="tel" dir="ltr" />
						</div>
						<div class="field">
							<label for="cf-email">Email</label>
							<input id="cf-email" name="email" type="email" autocomplete="email" dir="ltr" />
						</div>
					</div>
					<div class="field">
						<label for="cf-message">Message</label>
						<textarea id="cf-message" name="message" required></textarea>
					</div>
					<div class="form-captcha">
						<div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-size="flexible"></div>
					</div>
					<button class="btn-primary" type="submit">Send message</button>
					<p class="form-note" id="cf-status" role="status">{PAGES.contact.formNote}</p>
				</form>
			</div>
			<div class="contact-map">
				<div class="map-loading" aria-hidden="true">
					<span class="map-pin"></span>
				</div>
				<iframe
					src={CONTACT.mapEmbed}
					title={`Map showing ${CONTACT.company}, ${CONTACT.address.join(' ')}`}
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allowfullscreen
					onload="this.classList.add('is-loaded')"></iframe>
				<div class="map-card">
					<div>
						<strong>{CONTACT.company}</strong>
						<span>{CONTACT.address.join(' ')}</span>
					</div>
					<a class="btn-primary" href={directions} target="_blank" rel="noopener">Get directions</a>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
	// The address is stored reversed in the markup to keep it away from simple scrapers.
	const emailLink = document.querySelector<HTMLAnchorElement>('[data-email]');
	const email = emailLink?.dataset.email?.split('').reverse().join('') ?? '';
	if (emailLink && email) {
		emailLink.href = `mailto:${email}`;
		emailLink.textContent = email;
	}

	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('cf-status');
	const setStatus = (text: string, state = '') => {
		if (!status) return;
		status.textContent = text;
		status.dataset.state = state;
	};

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const data = new FormData(form);
		const name = String(data.get('name') ?? '').trim();
		const message = String(data.get('message') ?? '').trim();
		if (!name || !message) {
			setStatus('Please enter your name and a message.', 'error');
			(form.querySelector(name ? '#cf-message' : '#cf-name') as HTMLElement | null)?.focus();
			return;
		}

		// The captcha widget adds this field once the visitor has passed the check.
		const captcha = String(data.get('cf-turnstile-response') ?? '');
		if (!captcha) {
			setStatus('Please complete the security check above the button.', 'error');
			return;
		}

		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (button) button.disabled = true;
		setStatus('Sending…');
		try {
			const response = await fetch(form.dataset.endpoint!, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ ...Object.fromEntries(data), captcha }),
			});
			const result = await response.json().catch(() => ({}));
			if (response.ok) {
				form.reset();
				setStatus('Thank you. Your message has been sent to our team.', 'success');
			} else if ([400, 403, 429].includes(response.status)) {
				setStatus(result.error ?? 'Please check the form and try again.', 'error');
			} else {
				throw new Error(`Unexpected response ${response.status}`);
			}
		} catch {
			// The message could not be delivered: fall back to the visitor's email app so it is not lost.
			const body = [message, '', `Name: ${name}`, `Phone: ${data.get('phone') || '-'}`, `Email: ${data.get('email') || '-'}`].join('\n');
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(`Website enquiry from ${name}`)}&body=${encodeURIComponent(body)}`;
			setStatus('We could not send your message from this page, so your email app should now open with it ready to send.', 'error');
		} finally {
			if (button) button.disabled = false;
			// A captcha answer works once; ask for a fresh one for the next attempt.
			(window as { turnstile?: { reset(): void } }).turnstile?.reset();
		}
	});
</script>
