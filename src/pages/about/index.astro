---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Card from '../../components/Card.astro';
import { PAGES } from '../../consts';

const { title, cards } = PAGES.about;
---

<BaseLayout title={title} description="Learn about Masar Petroleum SAOC — our company background and the team behind Block 7.">
	<div class="container page">
		<PageHeading title={title} crumbs={[{ label: title, href: '/about/' }]} />
		<div class="grid grid-4">
			{cards.map((c) => <Card href={c.href} image={c.image} title={c.title} variant="centered" eager />)}
		</div>
	</div>
</BaseLayout>
