---
import NotFound from '../components/NotFound.astro';
---

<NotFound>
	<!-- GitHub Pages serves this one file for every missing address, so a missing
	     Arabic page is sent on to the Arabic version of this page. -->
	<script is:inline slot="head">
		if (/^\/ar(\/|$)/.test(location.pathname)) location.replace('/ar/404/');
	</script>
</NotFound>
