---
import BaseLayout from '../layouts/BaseLayout.astro';
import Billboard from '../components/Billboard.astro';
import NewsList from '../components/NewsList.astro';
import ArticleCarousel from '../components/ArticleCarousel.astro';
import { CONTACT, HOME, SITE } from '../consts';
import { renderText } from '../lib/text';

const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: `${SITE.name} SAOC`,
	alternateName: SITE.name,
	url: Astro.site?.href,
	logo: new URL(SITE.ogImage, Astro.site).href,
	foundingDate: '2015',
	address: { '@type': 'PostalAddress', streetAddress: CONTACT.address.join(' '), addressCountry: 'OM' },
	telephone: CONTACT.phone,
	email: CONTACT.email,
	sameAs: [CONTACT.linkedin].filter(Boolean),
};
const { intro } = HOME;
---

<BaseLayout>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(organization)} />

	{HOME.slides.length > 0 && <Billboard />}

	<section class="news-band" aria-labelledby="recent-news">
		<div class="container">
			<h2 class="section-title" id="recent-news">{HOME.newsTitle}</h2>
			<NewsList />
		</div>
	</section>

	<section class="parallax" aria-labelledby="about-masar" style={intro.background ? `background-image:url('${intro.background}')` : undefined}>
		<div class="container">
			<div class="intro-card" data-reveal>
				<h2 id="about-masar">{intro.title}</h2>
				<Fragment set:html={renderText(intro.text)} />
				{
					intro.buttonHref && intro.buttonLabel && (
						<p class="actions">
							<a class="btn-primary" href={intro.buttonHref}>
								{intro.buttonLabel}
							</a>
						</p>
					)
				}
			</div>
			<div class="values">
				{
					HOME.values.map((v) => (
						<div class="value-card">
							<img class="value-pin" src="/images/site/pin1.png" alt="" width="23" height="26" />
							<div class="value-inner">
								<img src={v.image} alt={v.title} width="500" height="333" loading="lazy" decoding="async" />
								<strong>{v.title}</strong>
								<p>{v.text}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="recent-articles">
		<div class="container">
			<h2 class="section-title center" id="recent-articles">{HOME.articlesTitle}</h2>
			<ArticleCarousel />
		</div>
	</section>
</BaseLayout>
