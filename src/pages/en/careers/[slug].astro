---
import { getCollection, render } from 'astro:content';
import PageShell from '../../../components/PageShell.astro';
import { siteContent } from '../../../data/siteContent';
import { FiArrowLeft, FiCalendar, FiMapPin } from 'react-icons/fi';

export async function getStaticPaths() {
	const roles = await getCollection('careers', (entry) => entry.data.lang === 'en');
	return roles.map((role) => ({
		params: { slug: role.id.replace('en/', '') },
		props: { role },
	}));
}

const { role } = Astro.props;
const { Content } = await render(role);
const content = siteContent.en;

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PageShell content={content} title={`${role.data.title} | Careers | Masar Petroleum`} description={role.data.excerpt}>
	<article class="mx-auto w-[calc(100%-1.5rem)] max-w-[820px] sm:w-[calc(100%-2.5rem)]">
		<a href="/en/careers/" class="inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition hover:gap-3 dark:text-sky-300">
			<FiArrowLeft className="h-4 w-4" />
			All open roles
		</a>

		<div class="mt-6 flex flex-col items-center gap-3 text-center">
			<div class="flex flex-wrap items-center justify-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-masar-copper">
				<span class="inline-flex items-center gap-1.5"><FiMapPin className="h-3.5 w-3.5" />{role.data.location}</span>
				<span>·</span>
				<span>{role.data.employmentType}</span>
			</div>
			<h1 class="max-w-[24ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl">
				{role.data.title}
			</h1>
			<div class="flex items-center gap-2 text-sm font-semibold text-slate-500 dark:text-slate-400">
				<FiCalendar className="h-4 w-4" />
				Posted {dateFormatter.format(role.data.date)}
			</div>
		</div>

		<div class="news-article mx-auto mt-10 text-start text-base leading-8 text-slate-700 dark:text-slate-300">
			<Content />
		</div>

		<div class="mt-10 rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/50">
			<p class="text-base font-semibold text-slate-800 dark:text-slate-100">Interested in this role?</p>
			<a href="/en/contact/" class="mt-4 inline-flex items-center gap-2 rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 dark:bg-white dark:text-slate-950">
				Get in touch
			</a>
		</div>
	</article>
</PageShell>
