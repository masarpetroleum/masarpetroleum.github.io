---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Card from '../../components/Card.astro';
import { PAGES } from '../../consts';
import { getCareers } from '../../lib/content';
import { renderText } from '../../lib/text';

const jobs = await getCareers();
const { title, intro, links } = PAGES.careers;
---

<BaseLayout title={title} description="Job opportunities at Masar Petroleum, Oman.">
	<div class="container page">
		<PageHeading title={title} crumbs={[{ label: title, href: '/careers/' }]} />
		<div class="box page-intro">
			<Fragment set:html={renderText(intro)} />
			{
				links.map((l) => (
					<p>
						<a class="arrow-link" href={l.href} target="_blank" rel="noopener">
							{l.label}
						</a>
					</p>
				))
			}
		</div>
		<div class="grid grid-2">
			{jobs.map((j) => <Card href={`/careers/${j.id}/`} image={j.data.image} title={j.data.title} badge={j.data.status} variant="wide" eager />)}
		</div>
	</div>
</BaseLayout>
