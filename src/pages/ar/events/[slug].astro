---
import { getCollection, render } from 'astro:content';
import PageShell from '../../../components/PageShell.astro';
import { siteContent } from '../../../data/siteContent';
import { FiArrowRight, FiCalendar, FiMapPin } from 'react-icons/fi';

export async function getStaticPaths() {
	const events = await getCollection('events', (entry) => entry.data.lang === 'ar');
	return events.map((event) => ({
		params: { slug: event.id.replace('ar/', '') },
		props: { event },
	}));
}

const { event } = Astro.props;
const { Content } = await render(event);
const content = siteContent.ar;

const dateFormatter = new Intl.DateTimeFormat('ar', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PageShell content={content} title={`${event.data.title} | الفعاليات | مسار بتروليوم`} description={event.data.excerpt}>
	<article class="mx-auto w-[calc(100%-1.5rem)] max-w-[820px] sm:w-[calc(100%-2.5rem)]">
		<a href="/ar/events/" class="inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition hover:gap-3 dark:text-sky-300">
			<FiArrowRight className="h-4 w-4" />
			كل الفعاليات
		</a>

		<div class="mt-6 flex flex-col items-center gap-3 text-center">
			<div class="flex flex-wrap items-center justify-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-masar-copper">
				<span class="inline-flex items-center gap-1.5"><FiCalendar className="h-3.5 w-3.5" />{dateFormatter.format(event.data.date)}</span>
				<span>·</span>
				<span class="inline-flex items-center gap-1.5"><FiMapPin className="h-3.5 w-3.5" />{event.data.location}</span>
			</div>
			<h1 class="max-w-[24ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl">
				{event.data.title}
			</h1>
		</div>

		<div class="news-article mx-auto mt-10 text-start text-base leading-8 text-slate-700 dark:text-slate-300">
			<Content />
		</div>
	</article>
</PageShell>
