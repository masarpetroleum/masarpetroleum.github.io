---
import type { SiteContent } from '../data/siteContent';
import { FiExternalLink, FiMapPin, FiPhoneCall } from 'react-icons/fi';

interface Props {
	content: SiteContent;
}

const { content } = Astro.props;
const isRtl = content.dir === 'rtl';
const year = new Date().getFullYear();

const copy =
	content.lang === 'ar'
		? {
			tagline: content.footer,
			getInTouch: 'تواصل معنا',
			rights: `© ${year} مسار بتروليوم. جميع الحقوق محفوظة.`,
		}
		: {
			tagline: content.footer,
			getInTouch: 'Get in touch',
			rights: `© ${year} Masar Petroleum. All rights reserved.`,
		};

const phoneHref = `tel:${content.contact.phone.replace(/\s+/g, '')}`;
---

<footer class="relative mt-16 w-full border-t border-white/10 bg-slate-950 text-white">
	<div class="mx-auto grid w-[calc(100%-1.5rem)] max-w-[1320px] gap-10 px-6 py-14 sm:w-[calc(100%-2.5rem)] sm:px-8 lg:grid-cols-[1.3fr_1fr] lg:gap-8 lg:py-16">
		<div class="flex flex-col items-center gap-4 text-center lg:items-start lg:text-start">
			<img src="/logo-light.png" alt="Masar Petroleum logo" class="h-14 w-auto" />
			<p class="max-w-sm text-sm leading-7 text-white/65">{copy.tagline}</p>
		</div>

		<div class="flex flex-col items-center gap-4 text-center lg:items-start lg:text-start">
			<h3 class="text-xs font-extrabold uppercase tracking-[0.3em] text-white/45">{copy.getInTouch}</h3>
			<ul class="flex flex-col items-center gap-3 text-sm font-semibold text-white/75 lg:items-start">
				<li>
					<a href={phoneHref} class={`flex items-center gap-2 transition hover:text-white ${isRtl ? 'flex-row-reverse' : ''}`}>
						<FiPhoneCall className="h-4 w-4 text-masar-copper" />
						{content.contact.phone}
					</a>
				</li>
				<li>
					<a href={content.contact.linkedin} target="_blank" rel="noreferrer" class={`flex items-center gap-2 transition hover:text-white ${isRtl ? 'flex-row-reverse' : ''}`}>
						<FiExternalLink className="h-4 w-4 text-masar-copper" />
						{content.contact.linkedinLabel}
					</a>
				</li>
				<li class={`flex items-center gap-2 ${isRtl ? 'flex-row-reverse' : ''}`}>
					<FiMapPin className="h-4 w-4 text-masar-copper" />
					{content.contact.location}
				</li>
			</ul>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="mx-auto flex w-[calc(100%-1.5rem)] max-w-[1320px] flex-col items-center gap-2 px-6 py-6 text-center text-xs font-medium text-white/45 sm:w-[calc(100%-2.5rem)] sm:flex-row sm:justify-between sm:px-8 sm:text-start">
			<p>{copy.rights}</p>
		</div>
	</div>
</footer>
