---
interface Props {
	href: string;
	image: string;
	title: string;
	subtitle?: string;
	badge?: string;
	variant?: 'square' | 'wide' | 'centered';
	eager?: boolean;
}
const { href, image, title, subtitle, badge, variant = 'square', eager = false } = Astro.props;
---

<a class:list={['card', { wide: variant === 'wide', centered: variant === 'centered' }]} href={href} data-reveal>
	<div class="card-media">
		<img
			src={image}
			alt=""
			width={variant === 'wide' ? 640 : 400}
			height={variant === 'wide' ? 320 : 400}
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
		{badge && <span class="badge">{badge}</span>}
	</div>
	<div class="card-body">
		<span class="card-title">{title}</span>
		{subtitle && <span class="card-sub">{subtitle}</span>}
	</div>
</a>
