---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { SiteContent } from '../data/siteContent';
import SiteHeader from './SiteHeader.astro';
import Footer from './Footer.astro';
import {
	FiArrowRight,
	FiArrowLeft,
	FiCompass,
	FiFileText,
	FiRadio,
	FiShield,
	FiTrendingUp,
} from 'react-icons/fi';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;

const isRtl = content.dir === 'rtl';
const currentPath = `/${content.lang}/`;
const ArrowIcon = isRtl ? FiArrowLeft : FiArrowRight;

const heroSlides =
	content.lang === 'ar'
		? [
			{ image: '/slides/1.jpg', kicker: 'رسالتنا', title: 'نشق طرقاً جديدة في النفط والغاز' },
			{ image: '/slides/2.jpg', kicker: 'مسار', title: 'نمنح المستقبل طاقته ونرسم الطريق' },
			{ image: '/slides/3.jpg', kicker: 'مسار بتروليوم', title: 'نمهد الطريق للطاقة' },
		]
		: [
			{ image: '/slides/1.jpg', kicker: 'Our Mission', title: 'Forging New Paths in Oil and Gas!' },
			{ image: '/slides/2.jpg', kicker: 'Masar', title: 'Powering the Future, Shaping the Way' },
			{ image: '/slides/3.jpg', kicker: 'Masar Petroleum', title: 'Paving the way for energy' },
		];

const operationIcons = [FiTrendingUp, FiRadio];

const findNavHref = (fragment: string, fallback: string) =>
	content.nav.find((item) => item.href.includes(fragment))?.href ?? fallback;

const aboutHref = findNavHref('/about/', `/${content.lang}/about/`);
const operationsHref = findNavHref('/operations/', `/${content.lang}/operations/`);
const impactHref = findNavHref('/impact/', `/${content.lang}/impact/`);
const newsHref = findNavHref('/news/', `/${content.lang}/news/`);
const contactHref = findNavHref('/contact/', `/${content.lang}/contact/`);

const moreLabel = content.lang === 'ar' ? 'اقرأ المزيد' : 'Learn more';
const allNewsLabel = content.lang === 'ar' ? 'كل الأخبار' : 'All news';
const seeOperationsLabel = content.lang === 'ar' ? 'كل العمليات' : 'All operations';

const newsPreview = (await getCollection('news', (entry) => entry.data.lang === content.lang))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);
const slugOf = (id: string) => id.replace(`${content.lang}/`, '');
---

<Layout title={title} description={description} lang={content.lang} dir={content.dir}>
	<div class="min-h-screen text-slate-900 dark:text-slate-100">
		<SiteHeader content={content} currentPath={currentPath} />

		<main class="overflow-x-clip">
			<section class="relative w-full overflow-hidden bg-slate-950 text-white">
				<div class="relative h-screen min-h-[720px]">
					{heroSlides.map((slide, index) => (
						<article class="hero-slide absolute inset-0" style={`--slide-index: ${index}; background-image: linear-gradient(120deg, rgba(7, 11, 23, 0.82), rgba(7, 11, 23, 0.32)), url(${slide.image});`}>
							<div class="mx-auto flex h-full w-full max-w-[1320px] flex-col items-center justify-center gap-5 px-6 pb-28 pt-24 text-center sm:px-8 sm:pt-28 lg:px-10">
								<p class={`hero-kicker text-xs font-bold tracking-[0.5em] text-white/75 sm:text-sm ${isRtl ? '' : 'uppercase'}`}>
									{slide.kicker}
								</p>
								<h1 class="hero-title max-w-4xl text-[clamp(1.85rem,5vw,3.75rem)] font-extrabold leading-[1.15] tracking-[-0.02em] text-white drop-shadow-[0_10px_30px_rgba(0,0,0,0.55)]">
									{slide.title}
								</h1>
							</div>
						</article>
					))}

					<div class="absolute inset-x-0 bottom-0 z-20 mx-auto flex w-[calc(100%-1.5rem)] max-w-[1320px] flex-col items-center gap-7 px-6 pb-14 text-center sm:w-[calc(100%-2.5rem)] sm:px-8 sm:pb-16">
						<p class="max-w-2xl text-sm leading-7 text-white/85 sm:text-base">{content.hero.description}</p>

						<div class="flex flex-wrap items-center justify-center gap-4">
							<a href={content.hero.primaryCta.href} class="rounded-full bg-white px-7 py-3 text-sm font-bold text-slate-950 shadow-[0_14px_34px_rgba(0,0,0,0.35)] transition hover:-translate-y-0.5 hover:bg-masar-sand">
								{content.hero.primaryCta.label}
							</a>
							<a href={content.hero.secondaryCta.href} class="rounded-full border border-white/40 px-7 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-white/10">
								{content.hero.secondaryCta.label}
							</a>
						</div>

						<div class="flex items-center gap-3">
							{heroSlides.map((_, index) => (
								<span class="hero-dot block h-2 rounded-full bg-white/35" style={`--slide-index: ${index}`}></span>
							))}
						</div>
					</div>
				</div>
			</section>

			<section class="mx-auto mt-16 grid w-[calc(100%-1.5rem)] max-w-[1320px] gap-4 sm:w-[calc(100%-2.5rem)] sm:grid-cols-3">
				{content.metrics.map((metric) => (
					<div class="rounded-[1rem] border border-white/60 bg-[linear-gradient(145deg,rgba(255,255,255,0.92),rgba(246,240,233,0.72))] p-5 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-[linear-gradient(145deg,rgba(15,23,42,0.88),rgba(30,41,59,0.72))]">
						<strong class="block text-4xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white">{metric.value}</strong>
						<span class="mt-2 block text-sm leading-7 text-slate-600 dark:text-slate-300">{metric.label}</span>
					</div>
				))}
			</section>

			<section class="mx-auto mt-8 w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
				<div class="rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/50 sm:p-10">
					<FiCompass className="mx-auto h-6 w-6 text-masar-sky dark:text-sky-300" />
					<h2 class="mx-auto mt-5 max-w-[20ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl">
						{content.about.title}
					</h2>
					<p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">{content.about.text}</p>
					<a href={aboutHref} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition hover:gap-3 dark:text-sky-300">
						{moreLabel}
						<ArrowIcon className="h-4 w-4" />
					</a>
				</div>
			</section>

			<section class="mx-auto mt-8 w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
				<div class="flex flex-col items-center gap-2 text-center">
					<h2 class="text-2xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white sm:text-3xl">{content.operations.title}</h2>
				</div>

				<div class="mt-6 grid gap-6 lg:grid-cols-2">
					{content.operations.items.map((item, index) => {
						const Icon = operationIcons[index % operationIcons.length];
						return (
							<article class="rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/50 sm:p-7">
								<Icon className="mx-auto h-6 w-6 text-masar-sky dark:text-sky-300" />
								<h3 class="mt-5 text-xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white">{item.title}</h3>
								<p class="mt-3 text-base leading-8 text-slate-600 dark:text-slate-300">{item.text}</p>
							</article>
						);
					})}
				</div>

				<div class="mt-6 flex justify-center">
					<a href={operationsHref} class="inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition hover:gap-3 dark:text-sky-300">
						{seeOperationsLabel}
						<ArrowIcon className="h-4 w-4" />
					</a>
				</div>
			</section>

			<section class="mx-auto mt-8 w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
				<div class="rounded-[1rem] border border-white/60 bg-[linear-gradient(145deg,rgba(255,255,255,0.92),rgba(246,240,233,0.72))] p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-[linear-gradient(145deg,rgba(15,23,42,0.88),rgba(30,41,59,0.72))] sm:p-10">
					<FiShield className="mx-auto h-6 w-6 text-masar-copper dark:text-amber-300" />
					<h2 class="mt-5 text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl">{content.impact.title}</h2>
					<p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">{content.impact.text}</p>
					<a href={impactHref} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition hover:gap-3 dark:text-sky-300">
						{moreLabel}
						<ArrowIcon className="h-4 w-4" />
					</a>
				</div>
			</section>

			<section class="mx-auto mt-8 w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
				<div class="flex flex-col items-center gap-2 text-center">
					<p class="text-xs font-extrabold uppercase tracking-[0.35em] text-masar-copper">{content.news.kicker}</p>
					<h2 class="text-2xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white sm:text-3xl">{content.news.title}</h2>
				</div>

				<div class="mt-6 grid gap-6 lg:grid-cols-2">
					{newsPreview.map((post) => (
						<a
							href={`/${content.lang}/news/${slugOf(post.id)}/`}
							class="group rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl transition hover:-translate-y-1 dark:border-white/10 dark:bg-slate-950/50 sm:p-7"
						>
							<FiFileText className="mx-auto h-6 w-6 text-masar-copper dark:text-amber-300" />
							<h3 class="mt-5 text-xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white">{post.data.title}</h3>
							<p class="mt-3 text-base leading-8 text-slate-600 dark:text-slate-300">{post.data.excerpt}</p>
						</a>
					))}
				</div>

				<div class="mt-6 flex justify-center">
					<a href={newsHref} class="inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition hover:gap-3 dark:text-sky-300">
						{allNewsLabel}
						<ArrowIcon className="h-4 w-4" />
					</a>
				</div>
			</section>

			<section class="mx-auto mt-8 w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
				<div class="rounded-[1rem] border border-white/60 bg-slate-950 p-8 text-center text-white shadow-[0_18px_50px_rgba(15,23,42,0.18)] sm:p-12">
					<h2 class="text-2xl font-extrabold tracking-[-0.04em] sm:text-3xl">{content.contact.title}</h2>
					<p class="mx-auto mt-3 max-w-2xl text-base leading-8 text-white/70">{content.contact.text}</p>
					<a href={contactHref} class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3 text-sm font-bold text-slate-950 transition hover:-translate-y-0.5 hover:bg-masar-sand">
						{content.hero.secondaryCta.label}
						<ArrowIcon className="h-4 w-4" />
					</a>
				</div>
			</section>
		</main>

		<Footer content={content} />
	</div>
</Layout>

<style>
	.hero-slide {
		background-position: center;
		background-size: cover;
		opacity: 0;
		transform: scale(1.04);
		animation: hero-cycle 24s infinite;
		animation-delay: calc(var(--slide-index) * 8s);
	}

	@keyframes hero-cycle {
		0% {
			opacity: 0;
			transform: scale(1.04);
		}

		6% {
			opacity: 1;
		}

		30% {
			opacity: 1;
			transform: scale(1);
		}

		33.333% {
			opacity: 0;
		}

		100% {
			opacity: 0;
			transform: scale(1.01);
		}
	}

	.hero-kicker,
	.hero-title {
		opacity: 0;
		transform: translateY(18px);
		animation: hero-text-cycle 24s infinite;
		animation-delay: calc(var(--slide-index) * 8s);
	}

	.hero-title {
		animation-delay: calc(var(--slide-index) * 8s + 0.12s);
	}

	@keyframes hero-text-cycle {
		0% {
			opacity: 0;
			transform: translateY(18px);
		}

		6% {
			opacity: 1;
			transform: translateY(0);
		}

		28% {
			opacity: 1;
			transform: translateY(0);
		}

		33.333% {
			opacity: 0;
			transform: translateY(-12px);
		}

		100% {
			opacity: 0;
			transform: translateY(-12px);
		}
	}

	.hero-dot {
		width: 0.5rem;
		background-color: rgba(255, 255, 255, 0.35);
		animation: hero-dot-cycle 24s infinite;
		animation-delay: calc(var(--slide-index) * 8s);
	}

	@keyframes hero-dot-cycle {
		0%,
		100% {
			width: 0.5rem;
			background-color: rgba(255, 255, 255, 0.35);
		}

		6% {
			width: 1.75rem;
			background-color: #ffffff;
		}

		30% {
			width: 1.75rem;
			background-color: #ffffff;
		}

		33.333% {
			width: 0.5rem;
			background-color: rgba(255, 255, 255, 0.35);
		}
	}
</style>
