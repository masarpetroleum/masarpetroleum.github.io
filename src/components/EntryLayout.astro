---
// Shared detail-page layout: page banner, sectioned body, optional side photo
// or gallery, and related topics.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from './PageHeading.astro';
import RelatedTopics from './RelatedTopics.astro';

interface Props {
	title: string;
	subtitle?: string;
	description?: string;
	image?: string;
	crumbs: Array<{ label: string; href?: string }>;
	aside?: string;
	gallery?: string[];
	tags?: string[];
}

const { title, subtitle, description, image, crumbs, aside, gallery = [], tags = [] } = Astro.props;
// A single photo sits beside the text; several become a gallery below it.
const sidePhoto = aside ?? (gallery.length === 1 ? gallery[0] : undefined);
const galleryImages = gallery.length > 1 ? gallery : [];
---

<BaseLayout title={title} description={description} image={image} type="article">
	<PageHeading title={title} subtitle={subtitle} crumbs={crumbs} />
	<div class="container page">
		<article class="entry">
			<div class:list={['entry-layout', { 'has-aside': sidePhoto }]}>
				<div class="prose">
					<slot />
				</div>
				{
					sidePhoto && (
						<div class="entry-aside">
							<a href={sidePhoto} data-lightbox="entry">
								<img src={sidePhoto} alt={title} width="450" height="450" loading="lazy" decoding="async" />
							</a>
						</div>
					)
				}
			</div>
			{
				galleryImages.length > 0 && (
					<div class="gallery" aria-label="Photo gallery">
						{galleryImages.map((src, i) => (
							<a href={src} data-lightbox="entry">
								<img src={src} alt={`${title} — photo ${i + 1}`} width="300" height="300" loading="lazy" decoding="async" />
							</a>
						))}
					</div>
				)
			}
			<RelatedTopics tags={tags} />
		</article>
		<slot name="after" />
	</div>
</BaseLayout>
