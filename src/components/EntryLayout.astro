---
// Shared detail-page layout: page banner, sectioned body, optional side photo
// or gallery, and related topics.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from './PageHeading.astro';
import RelatedTopics from './RelatedTopics.astro';
import Sidebar from './Sidebar.astro';
import { langFromPath, useT } from '../i18n';

interface Props {
	title: string;
	subtitle?: string;
	description?: string;
	image?: string;
	crumbs: Array<{ label: string; href?: string }>;
	aside?: string;
	gallery?: string[];
	tags?: string[];
	tagKeys?: string[];
	/** False when this Arabic page is showing English text, for want of a translation. */
	translated?: boolean;
}

const { title, subtitle, description, image, crumbs, aside, gallery = [], tags = [], tagKeys = tags, translated = true } = Astro.props;
const t = useT(langFromPath(Astro.url.pathname));
// A single photo sits beside the text; several become a gallery below it.
const sidePhoto = aside ?? (gallery.length === 1 ? gallery[0] : undefined);
const galleryImages = gallery.length > 1 ? gallery : [];
// Pages without a photo beside the text get the news sidebar there instead.
const sidebar = !sidePhoto;
---

<BaseLayout title={title} description={description} image={image} type="article">
	<PageHeading title={title} subtitle={subtitle} crumbs={crumbs} compact />
	<div class="container page">
		<article class="entry">
			{!translated && <p class="notice notice-inline">{t('translationPending')}</p>}
			<div class:list={['entry-layout', { 'has-aside': sidePhoto, 'has-sidebar': sidebar }]}>
				<div class="entry-main">
				<div class="prose" lang={translated ? undefined : 'en'} dir={translated ? undefined : 'ltr'}>
					<slot />
				</div>
			{
				galleryImages.length > 0 && (
					<div class="gallery" aria-label={t('photoGallery')}>
						{galleryImages.map((src, i) => (
							<a href={src} data-lightbox="entry">
								<img src={src} alt={`${title} — ${t('photo')} ${i + 1}`} width="300" height="300" loading="lazy" decoding="async" />
							</a>
						))}
					</div>
				)
			}
			<RelatedTopics tagKeys={tagKeys} tags={tags} />
				</div>
				{
					sidePhoto && (
						<div class="entry-aside">
							<a href={sidePhoto} data-lightbox="entry">
								<img src={sidePhoto} alt={title} width="450" height="450" loading="lazy" decoding="async" />
							</a>
						</div>
					)
				}
				{sidebar && <Sidebar />}
			</div>
		</article>
		<slot name="after" />
	</div>
</BaseLayout>
