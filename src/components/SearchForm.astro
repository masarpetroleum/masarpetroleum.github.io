---
import { langFromPath, localizePath, useT } from '../i18n';

interface Props {
	id: string;
	value?: string;
}
const { id, value = '' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
---

<form class="search-form" action={localizePath('/search/', lang)} method="get" role="search">
	<label class="sr-only" for={id}>{t('search')}</label>
	<input id={id} name="key" type="search" placeholder={t('keyword')} autocomplete="off" enterkeyhint="search" value={value} />
	<button type="submit" aria-label={t('search')}>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
			<circle cx="11" cy="11" r="7"></circle>
			<path d="m20 20-3.5-3.5"></path>
		</svg>
	</button>
</form>
