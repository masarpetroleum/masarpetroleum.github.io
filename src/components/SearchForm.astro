---
interface Props {
	id: string;
	value?: string;
}
const { id, value = '' } = Astro.props;
---

<form class="search-form" action="/search/" method="get" role="search">
	<label class="sr-only" for={id}>Search</label>
	<input id={id} name="key" type="search" placeholder="Keyword" autocomplete="off" value={value} />
	<button type="submit" aria-label="Search">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
			<circle cx="11" cy="11" r="7"></circle>
			<path d="m20 20-3.5-3.5"></path>
		</svg>
	</button>
</form>
