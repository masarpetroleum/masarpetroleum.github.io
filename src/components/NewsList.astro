---
import { getFeatured } from '../lib/content';

const items = await getFeatured();
const LABELS: Record<string, string> = { events: 'News', articles: 'Article', pages: 'Company', careers: 'Careers', team: 'Team' };
// Prefer the wide original artwork (images/content/N.jpg) for migrated entries.
const wide = (legacyId?: number, fallback?: string) => (legacyId ? `/images/content/${legacyId}.jpg` : fallback);
---

<div class="news-list">
	{
		items.map((item, i) => (
			<a class="news-item" href={item.url} data-reveal>
				<div class="news-media">
					<img src={wide(item.legacyId, item.image)} alt="" width="580" height="300" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
				</div>
				<div class="news-body">
					<span class="news-tag">{LABELS[item.section] ?? 'News'}</span>
					<strong>{item.title}</strong>
					{item.subtitle && <span class="sub">{item.subtitle}</span>}
					<span class="news-excerpt">{item.excerpt}</span>
					<span class="read-more">Read more</span>
				</div>
			</a>
		))
	}
</div>
