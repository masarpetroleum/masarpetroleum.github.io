---
import Layout from '../layouts/Layout.astro';
import type { SiteContent } from '../data/siteContent';
import SiteHeader from './SiteHeader.astro';
import Footer from './Footer.astro';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={title} description={description} lang={content.lang} dir={content.dir}>
	<div class="min-h-screen text-slate-900 dark:text-slate-100">
		<SiteHeader content={content} currentPath={currentPath} />
		<main class="overflow-x-clip pb-20 pt-32 sm:pt-36">
			<slot />
		</main>
		<Footer content={content} />
	</div>
</Layout>
