---
// The header is a React island (see header/SiteHeader.tsx). It is rendered to
// HTML at build time, so links work before the script loads.
import { CONTACT, NAV, SITE } from '../consts';
import SiteHeader from './header/SiteHeader';
---

<SiteHeader
	client:load
	items={NAV}
	path={Astro.url.pathname}
	logo={SITE.logo}
	siteName={SITE.name}
	contact={{ phone: CONTACT.phone, phoneHref: CONTACT.phoneHref, email: CONTACT.email }}
/>
