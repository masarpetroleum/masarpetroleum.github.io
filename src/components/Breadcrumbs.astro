---
import { langFromPath, localizePath, useT } from '../i18n';

interface Props {
	/** Site paths are written without the language (`/about/`); it is added here. */
	items: Array<{ label: string; href?: string }>;
}
const lang = langFromPath(Astro.url.pathname);
const current = Astro.url.pathname.replace(/\/?$/, '/');
const crumbs = [{ label: useT(lang)('home'), href: '/' }, ...Astro.props.items].map((c) => ({
	...c,
	href: c.href && localizePath(c.href, lang),
}));
const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: crumbs.map((c, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: c.label,
		...(c.href ? { item: new URL(c.href, Astro.site).href } : {}),
	})),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
	<ol>
		{
			crumbs.map((c) => (
				<li>{!c.href || c.href === current ? <span aria-current={c.href ? 'page' : undefined}>{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>
			))
		}
	</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
