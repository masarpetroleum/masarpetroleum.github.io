---
import { getCollection } from 'astro:content';
import PageShell from '../PageShell.astro';
import type { SiteContent } from '../../data/siteContent';
import { FiArrowRight, FiArrowLeft, FiCalendar } from 'react-icons/fi';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;
const isRtl = content.dir === 'rtl';
const ArrowIcon = isRtl ? FiArrowLeft : FiArrowRight;

const readMoreLabel = content.lang === 'ar' ? 'اقرأ الخبر' : 'Read story';

const posts = (await getCollection('news', (entry) => entry.data.lang === content.lang)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat(content.lang === 'ar' ? 'ar' : 'en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const slugOf = (id: string) => id.replace(`${content.lang}/`, '');
---

<PageShell content={content} title={title} description={description}>
	<section class="mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
		<div class="flex flex-col items-center gap-3 text-center">
			<p class="text-xs font-extrabold uppercase tracking-[0.35em] text-masar-copper">{content.news.kicker}</p>
			<h1 class="max-w-[18ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl lg:text-5xl">
				{content.news.title}
			</h1>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			{posts.map((post) => (
				<a
					href={`/${content.lang}/news/${slugOf(post.id)}/`}
					class="group rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl transition hover:-translate-y-1 dark:border-white/10 dark:bg-slate-950/50 sm:p-7"
				>
					<div class={`flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.28em] text-masar-copper dark:text-amber-300 ${isRtl ? 'flex-row-reverse' : ''}`}>
						<FiCalendar className="h-3.5 w-3.5" />
						{dateFormatter.format(post.data.date)}
					</div>
					<h2 class="mt-4 text-2xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white">{post.data.title}</h2>
					<p class="mt-3 text-base leading-8 text-slate-600 dark:text-slate-300">{post.data.excerpt}</p>
					<span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition group-hover:gap-3 dark:text-sky-300">
						{readMoreLabel}
						<ArrowIcon className="h-4 w-4" />
					</span>
				</a>
			))}
		</div>
	</section>
</PageShell>
