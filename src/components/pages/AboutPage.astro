---
import PageShell from '../PageShell.astro';
import type { SiteContent } from '../../data/siteContent';
import { FiCompass, FiLayers, FiActivity, FiShield, FiMapPin } from 'react-icons/fi';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;

const kicker = content.nav.find((item) => item.href.includes('/about/'))?.label ?? content.nav[0].label;
const cardIcons = [FiCompass, FiLayers];
const highlightIcons = [FiMapPin, FiActivity, FiShield];
---

<PageShell content={content} title={title} description={description}>
	<section class="mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
		<div class="flex flex-col items-center gap-3 text-center">
			<p class="text-xs font-extrabold uppercase tracking-[0.35em] text-masar-copper">{kicker}</p>
			<h1 class="max-w-[18ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl lg:text-5xl">
				{content.about.title}
			</h1>
			<p class="max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">{content.about.text}</p>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-3">
			{content.hero.highlights.map((item, index) => {
				const Icon = highlightIcons[index % highlightIcons.length];
				return (
					<div class="rounded-[0.9rem] border border-slate-200/70 bg-slate-50/90 p-5 text-center dark:border-white/10 dark:bg-white/5">
						<Icon className="mx-auto h-5 w-5 text-masar-copper dark:text-amber-300" />
						<p class="mt-4 text-sm font-semibold leading-7 text-slate-700 dark:text-slate-200">{item}</p>
					</div>
				);
			})}
		</div>

		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			{content.about.cards.map((card, index) => {
				const Icon = cardIcons[index % cardIcons.length];
				return (
					<article class="rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/50 sm:p-7">
						<Icon className="mx-auto h-6 w-6 text-masar-sky dark:text-sky-300" />
						<h2 class="mt-5 text-2xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white">{card.title}</h2>
						<p class="mt-3 text-base leading-8 text-slate-600 dark:text-slate-300">{card.text}</p>
					</article>
				);
			})}
		</div>

		<div class="mt-6 grid gap-4 sm:grid-cols-3">
			{content.metrics.map((metric) => (
				<div class="rounded-[1rem] border border-white/60 bg-[linear-gradient(145deg,rgba(255,255,255,0.92),rgba(246,240,233,0.72))] p-5 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-[linear-gradient(145deg,rgba(15,23,42,0.88),rgba(30,41,59,0.72))]">
					<strong class="block text-4xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white">{metric.value}</strong>
					<span class="mt-2 block text-sm leading-7 text-slate-600 dark:text-slate-300">{metric.label}</span>
				</div>
			))}
		</div>
	</section>
</PageShell>
