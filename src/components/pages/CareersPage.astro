---
import { getCollection } from 'astro:content';
import PageShell from '../PageShell.astro';
import type { SiteContent } from '../../data/siteContent';
import { FiArrowRight, FiArrowLeft, FiBriefcase, FiMapPin } from 'react-icons/fi';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;
const isRtl = content.dir === 'rtl';
const ArrowIcon = isRtl ? FiArrowLeft : FiArrowRight;

const viewRoleLabel = content.lang === 'ar' ? 'عرض الوظيفة' : 'View role';

const roles = (await getCollection('careers', (entry) => entry.data.lang === content.lang)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const slugOf = (id: string) => id.replace(`${content.lang}/`, '');
---

<PageShell content={content} title={title} description={description}>
	<section class="mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
		<div class="flex flex-col items-center gap-3 text-center">
			<p class="text-xs font-extrabold uppercase tracking-[0.35em] text-masar-copper">{content.careers.kicker}</p>
			<h1 class="max-w-[18ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl lg:text-5xl">
				{content.careers.title}
			</h1>
			<p class="max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">{content.careers.text}</p>
		</div>

		{roles.length === 0 ? (
			<div class="mx-auto mt-10 max-w-2xl rounded-[1rem] border border-dashed border-slate-300 bg-slate-50/70 p-8 text-center dark:border-white/15 dark:bg-white/5 sm:p-12">
				<FiBriefcase className="mx-auto h-8 w-8 text-masar-sky dark:text-sky-300" />
				<h2 class="mx-auto mt-4 max-w-[26ch] text-xl font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white">
					{content.careers.emptyState.title}
				</h2>
				<p class="mx-auto mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{content.careers.emptyState.text}</p>
			</div>
		) : (
			<div class="mt-10 grid gap-6 lg:grid-cols-2">
				{roles.map((role) => (
					<a
						href={`/${content.lang}/careers/${slugOf(role.id)}/`}
						class="group rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl transition hover:-translate-y-1 dark:border-white/10 dark:bg-slate-950/50 sm:p-7"
					>
						<div class={`flex flex-wrap items-center justify-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-masar-copper dark:text-amber-300 ${isRtl ? 'flex-row-reverse' : ''}`}>
							<span class="inline-flex items-center gap-1.5"><FiMapPin className="h-3.5 w-3.5" />{role.data.location}</span>
							<span>·</span>
							<span>{role.data.employmentType}</span>
						</div>
						<h2 class="mt-4 text-2xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white">{role.data.title}</h2>
						<p class="mt-3 text-base leading-8 text-slate-600 dark:text-slate-300">{role.data.excerpt}</p>
						<span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-masar-sky transition group-hover:gap-3 dark:text-sky-300">
							{viewRoleLabel}
							<ArrowIcon className="h-4 w-4" />
						</span>
					</a>
				))}
			</div>
		)}
	</section>
</PageShell>
