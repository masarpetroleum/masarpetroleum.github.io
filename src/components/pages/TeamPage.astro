---
import PageShell from '../PageShell.astro';
import type { SiteContent } from '../../data/siteContent';
import { FiCompass, FiLayers, FiUsers } from 'react-icons/fi';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;
const cardIcons = [FiCompass, FiLayers];

const copy =
	content.lang === 'ar'
		? {
			comingSoonTitle: 'ملفات الفريق قادمة قريباً',
			comingSoonText: 'نعمل على نشر ملفات تعريفية لفريق القيادة والفريق الفني قريباً. تواصل معنا إن أردت معرفة المزيد عن الأشخاص القائمين على العمليات الميدانية لمسار بتروليوم.',
			contactCta: 'تواصل معنا',
			focusTitle: 'ما يركّز عليه فريقنا',
		}
		: {
			comingSoonTitle: 'Team profiles coming soon',
			comingSoonText: "We're publishing profiles for our leadership and technical team soon. Get in touch if you'd like to know more about the people behind Masar Petroleum's field operations.",
			contactCta: 'Contact us',
			focusTitle: 'What our team focuses on',
		};

const contactHref = content.nav.find((item) => item.href.includes('/contact/'))?.href ?? `/${content.lang}/contact/`;
---

<PageShell content={content} title={title} description={description}>
	<section class="mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
		<div class="flex flex-col items-center gap-3 text-center">
			<p class="text-xs font-extrabold uppercase tracking-[0.35em] text-masar-copper">{content.team.kicker}</p>
			<h1 class="max-w-[18ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl lg:text-5xl">
				{content.team.title}
			</h1>
			<p class="max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">{content.team.text}</p>
		</div>

		<div class="mt-10 rounded-[1rem] border border-dashed border-slate-300 bg-slate-50/70 p-8 text-center dark:border-white/15 dark:bg-white/5 sm:p-12">
			<FiUsers className="mx-auto h-8 w-8 text-masar-sky dark:text-sky-300" />
			<h2 class="mx-auto mt-4 max-w-[26ch] text-xl font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white">
				{copy.comingSoonTitle}
			</h2>
			<p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-slate-600 dark:text-slate-300">{copy.comingSoonText}</p>
			<a href={contactHref} class="mt-6 inline-flex items-center gap-2 rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 dark:bg-white dark:text-slate-950">
				{copy.contactCta}
			</a>
		</div>

		<div class="mt-10">
			<h2 class="text-center text-xl font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white">{copy.focusTitle}</h2>
			<div class="mt-6 grid gap-6 lg:grid-cols-2">
				{content.about.cards.map((card, index) => {
					const Icon = cardIcons[index % cardIcons.length];
					return (
						<article class="rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/50 sm:p-7">
							<Icon className="mx-auto h-6 w-6 text-masar-sky dark:text-sky-300" />
							<h3 class="mt-5 text-xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white">{card.title}</h3>
							<p class="mt-3 text-base leading-8 text-slate-600 dark:text-slate-300">{card.text}</p>
						</article>
					);
				})}
			</div>
		</div>
	</section>
</PageShell>
