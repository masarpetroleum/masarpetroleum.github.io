---
import PageShell from '../PageShell.astro';
import type { SiteContent } from '../../data/siteContent';
import { FiExternalLink, FiMapPin, FiPhoneCall } from 'react-icons/fi';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;
const isRtl = content.dir === 'rtl';
const kicker = content.nav.find((item) => item.href.includes('/contact/'))?.label ?? content.nav[4].label;

const contactCards = [
	{
		label: content.contact.phoneLabel,
		value: content.contact.phone,
		href: `tel:${content.contact.phone.replace(/\s+/g, '')}`,
		icon: FiPhoneCall,
		external: false,
	},
	{
		label: content.contact.linkedinLabel,
		value: 'Masar Petroleum',
		href: content.contact.linkedin,
		icon: FiExternalLink,
		external: true,
	},
	{
		label: content.contact.locationLabel,
		value: content.contact.location,
		href: null,
		icon: FiMapPin,
		external: false,
	},
];
---

<PageShell content={content} title={title} description={description}>
	<section class="mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
		<div class="flex flex-col items-center gap-3 text-center">
			<p class="text-xs font-extrabold uppercase tracking-[0.35em] text-masar-copper">{kicker}</p>
			<h1 class="max-w-[18ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl lg:text-5xl">
				{content.contact.title}
			</h1>
			<p class="max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">{content.contact.text}</p>
		</div>

		<div class="mt-10 grid gap-4 lg:grid-cols-3">
			{contactCards.map((card) => {
				const Icon = card.icon;
				const contentBlock = (
					<>
						<div class={`inline-flex h-11 w-11 items-center justify-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950 ${isRtl ? 'self-end' : ''}`}>
							<Icon className="h-5 w-5" />
						</div>
						<div class="mt-5">
							<p class="text-xs font-extrabold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">{card.label}</p>
							<p class="mt-3 text-lg font-bold leading-8 text-slate-900 dark:text-white">{card.value}</p>
						</div>
					</>
				);

				return card.href ? (
					<a href={card.href} target={card.external ? '_blank' : undefined} rel={card.external ? 'noreferrer' : undefined} class="rounded-[1rem] border border-slate-200/70 bg-slate-50/90 p-5 text-center transition hover:-translate-y-1 dark:border-white/10 dark:bg-white/5">
						{contentBlock}
					</a>
				) : (
					<div class="rounded-[1rem] border border-slate-200/70 bg-slate-50/90 p-5 text-center dark:border-white/10 dark:bg-white/5">
						{contentBlock}
					</div>
				);
			})}
		</div>
	</section>
</PageShell>
