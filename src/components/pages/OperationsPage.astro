---
import PageShell from '../PageShell.astro';
import type { SiteContent } from '../../data/siteContent';
import { FiTrendingUp, FiRadio } from 'react-icons/fi';

interface Props {
	content: SiteContent;
	title: string;
	description: string;
}

const { content, title, description } = Astro.props;

const kicker = content.nav.find((item) => item.href.includes('/operations/'))?.label ?? content.nav[1].label;
const operationIcons = [FiTrendingUp, FiRadio];
---

<PageShell content={content} title={title} description={description}>
	<section class="mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] sm:w-[calc(100%-2.5rem)]">
		<div class="flex flex-col items-center gap-3 text-center">
			<p class="text-xs font-extrabold uppercase tracking-[0.35em] text-masar-copper">{kicker}</p>
			<h1 class="max-w-[18ch] text-3xl font-extrabold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-4xl lg:text-5xl">
				{content.operations.title}
			</h1>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			{content.operations.items.map((item, index) => {
				const Icon = operationIcons[index % operationIcons.length];
				return (
					<article class="rounded-[1rem] border border-white/60 bg-white/70 p-6 text-center shadow-[0_18px_50px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/50 sm:p-7">
						<div class="flex items-center justify-center gap-3 text-masar-sky dark:text-sky-300">
							<Icon className="h-6 w-6" />
						</div>
						<h2 class="mt-5 text-2xl font-extrabold tracking-[-0.04em] text-slate-950 dark:text-white">{item.title}</h2>
						<p class="mt-3 text-base leading-8 text-slate-600 dark:text-slate-300">{item.text}</p>
					</article>
				);
			})}
		</div>
	</section>
</PageShell>
