---
import { HOME } from '../consts';

const SLIDES = HOME.slides;
---

<section class="billboard" aria-roledescription="carousel" aria-label="Highlights" data-billboard data-interval={HOME.slideInterval ?? 5}>
	{
		SLIDES.map((slide, i) => {
			const Tag = slide.ctaHref ? 'a' : 'div';
			return (
				<Tag
					class:list={['billboard-slide', `theme-${slide.theme ?? 'light'}`, { 'is-active': i === 0 }]}
					href={slide.ctaHref}
					aria-roledescription="slide"
					aria-label={`${i + 1} of ${SLIDES.length}`}
					aria-hidden={i === 0 ? undefined : 'true'}
				>
					<img
						class="bg"
						src={slide.image}
						alt=""
						width="2200"
						height="880"
						loading={i === 0 ? 'eager' : 'lazy'}
						fetchpriority={i === 0 ? 'high' : undefined}
						decoding="async"
					/>
					<div class="billboard-text">
						{i === 0 ? <h1 class="billboard-title">{slide.title}</h1> : <p class="billboard-title">{slide.title}</p>}
						{slide.subtitle && <p class="billboard-subtitle">{slide.subtitle}</p>}
						{slide.ctaHref && slide.ctaLabel && <span class="billboard-cta">{slide.ctaLabel}</span>}
					</div>
				</Tag>
			);
		})
	}
	<div class="billboard-dots">
		{SLIDES.map((_, i) => <button type="button" aria-label={`Show slide ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} />)}
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-billboard]').forEach((root) => {
		const slides = Array.from(root.querySelectorAll<HTMLElement>('.billboard-slide'));
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.billboard-dots button'));
		const interval = Math.max(2, Number(root.dataset.interval) || 5) * 1000;
		let current = 0;
		let timer: number | undefined;

		const go = (i: number) => {
			current = (i + slides.length) % slides.length;
			slides.forEach((s, n) => {
				s.classList.toggle('is-active', n === current);
				if (n === current) s.removeAttribute('aria-hidden');
				else s.setAttribute('aria-hidden', 'true');
				s.tabIndex = n === current ? 0 : -1;
			});
			dots.forEach((d, n) => d.setAttribute('aria-current', String(n === current)));
			schedule();
		};
		const schedule = () => {
			window.clearTimeout(timer);
			if (slides.length > 1) timer = window.setTimeout(() => go(current + 1), interval);
		};

		dots.forEach((d, n) => d.addEventListener('click', () => go(n)));

		// Swipe support on touch screens.
		let startX = 0;
		root.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
		root.addEventListener('touchend', (e) => {
			const dx = e.changedTouches[0].clientX - startX;
			if (Math.abs(dx) > 40) go(current + (dx < 0 ? 1 : -1));
		});

		document.addEventListener('visibilitychange', () => (document.hidden ? window.clearTimeout(timer) : schedule()));
		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) schedule();
	});
</script>
