---
// The home page hero is a React island (see hero/Hero.tsx). It is rendered to
// HTML at build time, so the first slide shows before the script loads.
import { HOME } from '../consts';
import Hero from './hero/Hero';

const interval = Math.max(2, Number(HOME.slideInterval) || 5);
---

<Hero client:load slides={HOME.slides} interval={interval} />
